  "cards": [
    {
      "dot": "emerald",
      "title": "Answering a question",
      "items": [
        "Redis is checked first; a cache hit returns immediately",
        "On a miss: fetch 6× candidates from Qdrant, LLM-rerank them, keep scores ≥ 0.6",
        "If nothing passes, a fixed 'no context' reply is returned without an LLM call",
        "Generated answers are cached for 1 hour"
      ]
    },
    {
      "dot": "rose",
      "title": "Production safeguards",
      "items": [
        "A daily Vercel cron calls /api/health, which reads Qdrant and returns 503 if it is unreachable",
        "Admin endpoints require X-API-Key and are disabled when no key is set",
        "API docs (/docs, /openapi.json) are served only in debug mode"
      ]
    },
    {
      "dot": "amber",
      "title": "Offline ingestion",
      "items": [
        "Vital-Atlas scrapes three sources into Markdown",
        "ingest.py runs locally: parse, chunk, embed, then upsert into Qdrant"
      ]
    }
  ]
