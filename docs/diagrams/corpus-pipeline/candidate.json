  "cards": [
    {
      "dot": "cyan",
      "title": "The contract is the file",
      "items": [
        "Vital-Atlas and Care-Beacon share only Markdown files and their frontmatter schema",
        "That boundary let Care-Beacon change hosts and swap vector stores without touching the scraper"
      ]
    },
    {
      "dot": "amber",
      "title": "Manual hand-off",
      "items": [
        "Files are copied from Vital-Atlas into scraped_data/ and ingested with make ingest",
        "Nothing reconciles the two sides, so the corpora can drift"
      ]
    },
    {
      "dot": "emerald",
      "title": "Kept out of the deploy",
      "items": [
        "scraped_data/ sits at the repository root, outside api/",
        ".vercelignore keeps its 25,000+ files out of the Vercel upload"
      ]
    }
  ]
