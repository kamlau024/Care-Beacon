  "cards": [
    {
      "dot": "emerald",
      "title": "Two shortcuts",
      "items": [
        "Cache hit: the answer comes straight from Redis, with no OpenAI cost",
        "Nothing relevant found: a fixed reply, with no answer-generation call"
      ]
    },
    {
      "dot": "amber",
      "title": "Why fetch 6× candidates",
      "items": [
        "With reranking on, Qdrant returns max_results × 6 so the reranker sees a wide pool",
        "A loose pre-filter keeps scores ≥ 0.3 before reranking",
        "After reranking, every chunk scoring ≥ 0.6 is kept, with no top-k cut"
      ]
    },
    {
      "dot": "cyan",
      "title": "Cache key",
      "items": [
        "SHA-256 of the lowercased question plus filters, max_results, and min_similarity"
      ]
    }
  ]
