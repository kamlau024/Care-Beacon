  "cards": [
    {
      "dot": "emerald",
      "title": "Follow-ups become searches",
      "items": [
        "On a follow-up, the last 4 turns and the new message are rewritten into one standalone query",
        "The first turn of a thread skips this step and searches the question as typed"
      ]
    },
    {
      "dot": "cyan",
      "title": "Conversation memory",
      "items": [
        "The most recent turns that fit a 6,000-character budget go into the prompt",
        "Old [n] markers are stripped so they can't be mistaken for this turn's sources"
      ]
    },
    {
      "dot": "amber",
      "title": "No lost answers",
      "items": [
        "On disconnect or error, the partial answer is saved with status interrupted",
        "Clients get a generic error frame; provider and database details are never echoed"
      ]
    },
    {
      "dot": "violet",
      "title": "Spend cap",
      "items": [
        "Every OpenAI call adds to a per-UTC-day cost counter in Redis",
        "At $2.00 chat returns 429 before any stream starts; Search keeps working"
      ]
    }
  ]
