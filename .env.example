# Care-Beacon Environment Variables
# Copy this file to .env and fill in your actual values

# Required: OpenAI API Key
OPENAI_API_KEY=sk-your-actual-openai-key-here

# Optional: Redis Configuration (defaults work for docker-compose)
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=

# Optional: API Configuration
# API_HOST=0.0.0.0
# API_PORT=8000
# API_DEBUG=false

# Optional: Logging
# LOG_LEVEL=INFO

# Optional: Ingestion Batch Sizes (for low-memory environments)
# Reduce these values if running out of memory during data ingestion
# INGESTION_ARTICLE_BATCH_SIZE=10  # Number of articles to process per batch (default: 10)
# INGESTION_CHUNK_BATCH_SIZE=50    # Number of chunks to add to vector DB per batch (default: 50)
