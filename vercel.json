{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "web-client/"
    },
    "api": {
      "root": "api/",
      "entrypoint": "src.api.main:app",
      "functions": {
        "src/api/main.py": {
          "maxDuration": 60
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/health",
      "schedule": "0 9 * * *"
    }
  ]
}
