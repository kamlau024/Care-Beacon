{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "web-client/"
    },
    "api": {
      "root": "api/",
      "entrypoint": "src.api.main:app",
      "excludeFiles": "{tests/**,scripts/**,**/test_*.py}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
